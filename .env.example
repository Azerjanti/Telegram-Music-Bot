# Required
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOP_PLAYLIST_ID=37i9dQZEVXbMDoHDwVN2tF

# Optional fallback database for non-Supabase environments. Runtime files use /tmp.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# --- Admin (owner) ---------------------------------------------------------
# Numeric Telegram ID of the owner(s) who can open the /admin panel.
#   * ADMIN_ID  = a single owner
#   * ADMIN_IDS = several owners, comma separated
# Not sure what your ID is? Send /id to the bot (or just press /admin - the bot
# answers with your numeric ID). Default when both are empty: 8377297659
ADMIN_ID=8377297659
ADMIN_IDS=8377297659
# Optional: owner by @username instead of a numeric id (comma separated).
# ADMIN_USERNAMES=my_username

# Runtime
PORT=8000
# Where the SQLite fallback catalogue is stored. Leave the default on a machine
# with a persistent disk; on Replit/Render /tmp is wiped on every restart, which
# empties the catalogue and the "Локальный топ". Example: /home/runner/music.sqlite3
MUSIC_DB_PATH=/tmp/music-bot/music.sqlite3
ENABLE_YTDLP_DOWNLOADS=true
ENABLE_SHAZAM=true
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_RETRIES=3
MAX_TELEGRAM_FILE_MB=50
AUDIO_CACHE_DIR=/tmp/music-bot/audio

# --- yt-dlp hardening / IP protection (all optional, env-configurable) ---
# Comma-separated YouTube clients that don't require PO-token / cookies.
# Default: tv,web_embedded,tv_embedded,visionos,ios (most reliable for bot-wall bypass)
# Use YTDLP_USE_YTDLP_DEFAULT_CLIENTS=true to let yt-dlp use its own default rotation.
YTDLP_PLAYER_CLIENTS=tv,web_embedded,tv_embedded,visionos,ios
# YTDLP_USE_YTDLP_DEFAULT_CLIENTS=false

# Impersonation via curl_cffi (chrome/safari). Requires `pip install curl_cffi`.
# Auto-enabled if curl_cffi is installed. Disable with 0/false/none.
YTDLP_ENABLE_IMPERSONATION=true
YTDLP_IMPERSONATE=chrome
# YTDLP_DEFAULT_IMPERSONATE=chrome

# Player skip: reduces API calls, helps avoid rate-limit. Default: configs
# Set to none/empty to disable skipping.
YTDLP_PLAYER_SKIP=configs

# Format preference: CLI example uses 251 (opus). Default tries 251 first.
YTDLP_FORMAT=251/250/140/m4a/bestaudio/best
YTDLP_PREFERRED_CODEC=mp3
YTDLP_PREFERRED_QUALITY=192

# IP protection / rate limiting (important to avoid datacenter IP flagging)
YTDLP_ENABLE_RATE_LIMIT=true
YTDLP_MIN_DOWNLOAD_INTERVAL=2.0
YTDLP_RANDOM_JITTER=true
YTDLP_SLEEP_INTERVAL=1.0
YTDLP_MAX_SLEEP_INTERVAL=5.0
YTDLP_SLEEP_REQUESTS=1.0
YTDLP_CONCURRENT_FRAGMENTS=1

# Network hardening
YTDLP_SOCKET_TIMEOUT=30
YTDLP_RETRIES=3
YTDLP_FRAGMENT_RETRIES=3
YTDLP_EXTRACTOR_RETRIES=3
YTDLP_GEO_BYPASS=true
YTDLP_GEO_BYPASS_COUNTRY=US
# YTDLP_FORCE_IPV4=false
# YTDLP_ACCEPT_LANGUAGE=en-US,en;q=0.9

# Advanced: visitor_data, throttled rate, http chunk size, etc.
# YTDLP_VISITOR_DATA=
# YTDLP_THROTTLED_RATE=
# YTDLP_HTTP_CHUNK_SIZE=10485760
# YTDLP_USER_AGENT= (avoid setting unless impersonation disabled - mismatched UA triggers bot-wall)
# YTDLP_JS_RUNTIMES=deno,node

# Allow PO-token clients (android/web) if you have PO-token setup. Default false.
YTDLP_ALLOW_PO_CLIENTS=false

# Debug
# YTDLP_DEBUG=false
