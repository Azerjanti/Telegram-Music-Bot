# Required
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOP_PLAYLIST_ID=37i9dQZEVXbMDoHDwVN2tF

# Replit supplies DATABASE_URL when the built-in PostgreSQL database is enabled.
# When it is absent, the bot uses music_bot/.cache/music.sqlite3 for local development.
DATABASE_URL=

# Runtime
PORT=8000
ENABLE_YTDLP_DOWNLOADS=true
ENABLE_SHAZAM=true
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_RETRIES=3
MAX_TELEGRAM_FILE_MB=50
AUDIO_CACHE_DIR=music_bot/.cache/audio