# Required
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOP_PLAYLIST_ID=37i9dQZEVXbMDoHDwVN2tF

# Optional fallback database for non-Supabase environments. Runtime files use /tmp.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Admin (owner) Telegram user ID(s) that can open /admin panel.
# ADMIN_ID = single owner; ADMIN_IDS = comma-separated list. Default: 8377297659
ADMIN_ID=8377297659
ADMIN_IDS=8377297659

# Runtime
PORT=8000
ENABLE_YTDLP_DOWNLOADS=true
ENABLE_SHAZAM=true
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_RETRIES=3
MAX_TELEGRAM_FILE_MB=50
AUDIO_CACHE_DIR=/tmp/music-bot/audio
