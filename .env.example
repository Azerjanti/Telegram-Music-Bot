# Required
BOT_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_TOP_PLAYLIST_ID=37i9dQZEVXbMDoHDwVN2tF

# Optional fallback database for non-Supabase environments. Runtime files use /tmp.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Admin (owner) Telegram user ID(s), comma separated, that can open /admin panel.
# Default (if unset): 8490020175
ADMIN_IDS=8490020175

# Runtime
PORT=8000
ENABLE_YTDLP_DOWNLOADS=true
ENABLE_SHAZAM=true
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_RETRIES=3
MAX_TELEGRAM_FILE_MB=50
AUDIO_CACHE_DIR=/tmp/music-bot/audio
